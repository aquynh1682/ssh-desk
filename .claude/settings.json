{
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make check)",
      "Bash(swift build:*)",
      "Bash(swift format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make run)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(open:*)",
      "Bash(osascript:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/**/id_*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/format-swift.sh" }
        ]
      }
    ]
  }
}
