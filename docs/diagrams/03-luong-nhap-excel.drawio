<mxfile host="drawio" type="device"><diagram id="03-luong-nhap-excel" name="Luồng nhập Excel/CSV"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Luồng nhập máy chủ từ Excel / CSV (ADR-026, 026b, 031)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="40" as="geometry"/></mxCell><mxCell id="s1" value="Chọn file .xlsx / .csv&lt;br&gt;hoặc nguồn có thay đổi (mtime + SHA-256)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="70" width="300" height="56" as="geometry"/></mxCell><mxCell id="s2" value="Đọc an toàn&lt;br&gt;XLSX: unzip -Z1 kiểm tên, unzip -p (argv, env rỗng),&lt;br&gt;cap 50/100 MB, chặn &amp;lt;!DOCTYPE&amp;gt;&lt;br&gt;CSV: BOM UTF-8/UTF-16, ≤ 5 MB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="340" height="90" as="geometry"/></mxCell><mxCell id="d1" value="Đúng file mẫu?&lt;br&gt;(sshdesk-template v1)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="405.0" y="290" width="250" height="100" as="geometry"/></mxCell><mxCell id="s3" value="Ghép cột&lt;br&gt;đoán theo tiêu đề Việt/Anh,&lt;br&gt;chọn cột khoá (external_id)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="780" y="305" width="260" height="70" as="geometry"/></mxCell><mxCell id="d2" value="Có cột giống&lt;br&gt;mật khẩu?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420.0" y="430" width="220" height="100" as="geometry"/></mxCell><mxCell id="s4" value='Mặc định BỎ QUA cột&lt;br&gt;Tuỳ chọn "Lưu mật khẩu từ cột X"&lt;br&gt;(TẮT, phải bật lại mỗi lần)&lt;br&gt;→ SecretColumnValues (che mọi mô tả)' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="435" width="290" height="90" as="geometry"/></mxCell><mxCell id="s5" value="Validate từng dòng&lt;br&gt;(IP, Port 1–65535, Môi trường, trùng tên…)&lt;br&gt;dòng lỗi bị bỏ, dòng tốt vẫn nhập" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="570" width="300" height="70" as="geometry"/></mxCell><mxCell id="s6" value="InventorySync lập kế hoạch&lt;br&gt;thêm · đổi (cũ → mới) · không còn trong nguồn · lỗi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="360" y="675" width="340" height="56" as="geometry"/></mxCell><mxCell id="d3" value='Phát hiện tự động&lt;br&gt;+ chỉ có thêm mới&lt;br&gt;+ "Tự thêm máy mới" bật?' style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="390.0" y="770" width="280" height="120" as="geometry"/></mxCell><mxCell id="s7" value="Tự áp dụng&lt;br&gt;(không lưu mật khẩu)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="795" width="220" height="70" as="geometry"/></mxCell><mxCell id="s8" value='Thông báo "Đã thêm N máy"&lt;br&gt;[Xem]  [Hoàn tác]' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="220" height="56" as="geometry"/></mxCell><mxCell id="s8b" value='Hoàn tác: xoá host chưa bị sửa,&lt;br&gt;chưa có mật khẩu/forward;&lt;br&gt;tắt "Tự thêm máy mới"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="25" y="1020" width="250" height="70" as="geometry"/></mxCell><mxCell id="s9" value="Màn xem trước&lt;br&gt;mật khẩu chỉ hiện ••••&lt;br&gt;số host sẽ lưu / đã có mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="930" width="300" height="70" as="geometry"/></mxCell><mxCell id="s10" value='Áp dụng → hộp xác nhận&lt;br&gt;"Lưu mật khẩu cho N máy vào kho mã hoá?"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="1040" width="300" height="60" as="geometry"/></mxCell><mxCell id="s11" value="Một transaction SQLite (lỗi → không ghi gì)&lt;br&gt;địa chỉ đổi → autofill_hold = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="1140" width="340" height="60" as="geometry"/></mxCell><mxCell id="s12" value="Lưu mật khẩu qua CredentialStore → Secure Enclave&lt;br&gt;ghi 0 buffer (memset_s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="360" y="1240" width="340" height="60" as="geometry"/></mxCell><mxCell id="s13" value="Sinh lại ssh/config&lt;br&gt;nhắc xoá / bảo vệ file Excel gốc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="1340" width="300" height="56" as="geometry"/></mxCell><mxCell id="note" value='Không bao giờ:&lt;br&gt;• tự xoá host (chỉ đánh dấu "không còn trong nguồn")&lt;br&gt;• đưa mật khẩu vào DB, log, preview, config_json&lt;br&gt;• tự áp dụng khi có sửa / biến mất / lỗi&lt;br&gt;• lưu mật khẩu khi đồng bộ tự động' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="760" y="1030" width="330" height="110" as="geometry"/></mxCell><mxCell id="y1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y3" value="Có — bỏ ghép cột" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y4" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="s3" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y6" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y7" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s6" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y11" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="s7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y12" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3" target="s9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="s7" target="s11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="848"/><mxPoint x="310" y="1170"/></Array></mxGeometry></mxCell><mxCell id="y14" value="sau khi áp dụng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y15" value="Hoàn tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="s8" target="s8b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s9" target="s10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s10" target="s11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y18" value="nếu bật lưu mật khẩu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s11" target="s12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="y19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s12" target="s13"><mxGeometry relative="1"