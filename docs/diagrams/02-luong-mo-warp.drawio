<mxfile host="drawio" type="device"><diagram id="02-luong-mo-warp" name="Luồng mở SSH trong Warp"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Luồng mở SSH trong Warp (ADR-006, 007, 010)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="lane0" value="SSH Desk (app)" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;collapsible=0;swimlaneLine=1;fontFamily=Helvetica;fontSize=12;fillColor=#eef4fc;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="520" height="1460" as="geometry"/></mxCell><mxCell id="lane1" value="File app sở hữu" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;collapsible=0;swimlaneLine=1;fontFamily=Helvetica;fontSize=12;fillColor=#fffbea;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="300" height="1460" as="geometry"/></mxCell><mxCell id="lane2" value="Warp + OpenSSH" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;collapsible=0;swimlaneLine=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="300" height="1460" as="geometry"/></mxCell><mxCell id="lane3" value="sshdesk-askpass" style="swimlane;html=1;startSize=30;horizontal=1;fontStyle=1;collapsible=0;swimlaneLine=1;fontFamily=Helvetica;fontSize=12;fillColor=#f5f0f8;" vertex="1" parent="1"><mxGeometry x="1120" y="50" width="520" height="1460" as="geometry"/></mxCell><mxCell id="a1" value='Người dùng chọn hồ sơ&lt;br&gt;→ "Mở trong Warp"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="130.0" y="100" width="260" height="56" as="geometry"/></mxCell><mxCell id="a2" value="ConnectionService&