<mxfile host="drawio" type="device"><diagram id="04-quy-trinh-agent" name="Quy trình đội agent"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Quy trình đội agent (skill ssh-desk-delivery)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="user" value="Người dùng&lt;br&gt;yêu cầu · chọn ý tưởng · thử app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="190" height="64" as="geometry"/></mxCell><mxCell id="main" value="Agent chính (Opus)&lt;br&gt;PM: chốt quyết định,&lt;br&gt;review diff, approve" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="195" width="210" height="74" as="geometry"/></mxCell><mxCell id="advisor" value="product-advisor (Fable)&lt;br&gt;ý tưởng, roadmap&lt;br&gt;→ docs/ideas.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="250" y="50" width="210" height="64" as="geometry"/></mxCell><mxCell id="research" value="researcher (Haiku)&lt;br&gt;tra tài liệu, lệnh chỉ đọc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="250" y="380" width="210" height="56" as="geometry"/></mxCell><mxCell id="pm" value="pm (Opus)&lt;br&gt;điều phối bước 0–4" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="210" height="64" as="geometry"/></mxCell><mxCell id="adr" value="docs/architecture.md&lt;br&gt;ghi ADR trước khi giao code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="50" width="210" height="64" as="geometry"/></mxCell><mxCell id="coder" value="coder (Sonnet)&lt;br&gt;code + test trên nhánh,&lt;br&gt;mỗi lúc 1 coder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="200" width="210" height="64" as="geometry"/></mxCell><mxCell id="doc" value="doc-writer (Sonnet)&lt;br&gt;chỉ file .md,&lt;br&gt;chạy song song coder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="790" y="480" width="210" height="64" as="geometry"/></mxCell><mxCell id="qa" value="qa-reviewer (Sonnet)&lt;br&gt;checklist bảo mật / ADR,&lt;br&gt;chỉ đọc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1050" y="200" width="210" height="64" as="geometry"/></mxCell><mxCell id="dqa" value='QA "Chặn"?' style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1320" y="187" width="160" height="90" as="geometry"/></mxCell><mxCell id="dcheck" value="make check xanh&lt;br&gt;+ PM duyệt diff?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1310" y="330" width="180" height="110" as="geometry"/></mxCell><mxCell id="commit" value='Commit (Co-Authored-By)&lt;br&gt;cập nhật ADR "Đã làm",&lt;br&gt;plan.md, progress.md' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1295" y="480" width="210" height="70" as="geometry"/></mxCell><mxCell id="rules" value="Quy tắc&lt;br&gt;• Worktree tạo từ main → coder làm thẳng trên nhánh&lt;br&gt;• Agent không nói chuyện với nhau; PM chuyển tiếp&lt;br&gt;• Push / mở PR chỉ khi người dùng yêu cầu&lt;br&gt;• Hết hạn mức / bị từ chối quyền → ghi progress.md, báo người dùng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="520" height="100" as="geometry"/></mxCell><mxCell id="t1" value="yêu cầu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="main"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t2" value="xin ý tưởng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="main" target="advisor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t3" value="đề xuất để chọn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="advisor" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="95" y="82"/></Array></mxGeometry></mxCell><mxCell id="t4" value="việc đã chọn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="main" target="pm"><mxGeometry relative=